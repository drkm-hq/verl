new file mode 100644
index 00000000..6b08e140
--- /dev/null
+++ b/tests/trainer/ppo/test_turn_rloo_on_cpu.py
@@ -0,0 +1,429 @@
+# Copyright 2026 Bytedance Ltd. and/or its affiliates
