diff --git a/tests/trainer/ppo/v1/test_validate_recovery_on_cpu.py b/tests/trainer/ppo/v1/test_validate_recovery_on_cpu.py
new file mode 100644
index 00000000..2695c22b
--- /dev/null
+++ b/tests/trainer/ppo/v1/test_validate_recovery_on_cpu.py
@@ -0,0 +1,367 @@
+# Copyright 2024 Bytedance Ltd. and/or its affiliates
+#
