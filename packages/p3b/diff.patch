+        trainer._submit_batch_to_rollout(batch)
+        restore()
+        assert manager.recovery_metrics["rollout/dead_workers_relaunched"] == 1
+        assert manager.recovery_metrics["rollout/prompts_orphaned_at_dispatch"] == 4
