index a14ec2af..0146b330 100644
--- a/verl/trainer/config/engine/fsdp.yaml
+++ b/verl/trainer/config/engine/fsdp.yaml
@@ -72,6 +72,14 @@ pad_to_length: false
 # within-budget micro-batch onto a single shape. Only read when pad_to_length=true.
 pad_to_length_bucket: 1024
 
+# Project the LM head only for the packed rows the loss reads (the row before each response token),
+# so head FLOPs and the (tokens, vocab) logits tensor shrink by the prompt fraction of the micro-batch.
+# Output-identical to the full projection. Requires use_remove_padding=True (rejected otherwise) and a model
