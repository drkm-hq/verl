+        ).result_or_raise()
+        assert calls == [[stuck]]
+        assert stub.agent_loop_manager.batches == []
+        assert [key.split("_")[0] for key in batch.keys] == [stuck]
+        assert rb._retired_uids[partition_id] == set()
+        assert metrics.get(f"{PREFIX}/inflight_reissued", 0) == 0
