+def test_liveness_fn_is_polled_and_dead_owned_prompts_are_reissued(tq_init, partition_id, monkeypatch):
+    monkeypatch.setattr(replay_buffer_module, "WORKER_LIVENESS_PERIOD_SECONDS", 0.0)
