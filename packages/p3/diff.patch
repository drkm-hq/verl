diff --git a/verl/trainer/config/ppo_trainer.yaml b/verl/trainer/config/ppo_trainer.yaml
index 971846f2..f90b6433 100644
--- a/verl/trainer/config/ppo_trainer.yaml
+++ b/verl/trainer/config/ppo_trainer.yaml
@@ -305,6 +305,32 @@ trainer:
       # Whether sync trainers replace failed groups that have no trajectories
       sync_refill_failed_groups: False
 
+      # Seconds a training prompt may stay pending/running, from dispatch to its terminal
+      # status INCLUDING engine queueing, before the replay buffer discards its partial rows
+      # and re-issues it under a fresh uid (any trainer mode). Catches prompts whose agent
+      # loop worker died or whose generation silently hangs. Must exceed the longest healthy
+      # generation phase (timing_s/gen max), otherwise healthy groups are regenerated.
+      # null disables the TTL: a prompt without a terminal status blocks sampling forever.
+      inflight_ttl_s: null
+
+      # Re-issues one prompt may receive (TTL or dead worker) before it is marked failure
+      # instead, so the existing failure paths (padding or refill) finish the step.
+      # 0 = never re-issue: an expired prompt is marked failure on its first expiry.
+      max_inflight_reissues: 3
+
+      # TTL-induced discards allowed within one training step, counted across the sampling
+      # calls that share a global_steps (parameter_sync_step mini-batches, the separate_async
