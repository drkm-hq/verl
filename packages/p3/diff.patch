+def test_step_budget_caps_a_poll_to_the_oldest_expired_prompts(tq_init, partition_id):
+    """Three prompts expire in one poll with two re-issues left in the budget: the two oldest are re-issued,
+    the third waits and is never re-issued later in the same call."""
+    now = time.time()
+    uids = [_uid() for _ in range(3)]
+    for age, uid in zip((300, 200, 100), uids, strict=True):
+        _submit_prompt(partition_id, uid, "running", 1, dispatched_at=now - age)
+    reissuer = RecordingReissuer(partition_id)
+    try:
+        rb = _make_rb(inflight_ttl_s=1, max_inflight_reissues_per_step=2, reissue_fn=reissuer)
+        rb._sync_metadata_from_transfer_queue()
+        metrics: dict = {}
+        assert rb._recover_stuck_inflight(partition_id, metrics, reissue_budget=rb._reissue_budget(3)) is True
+        assert reissuer.calls == [sorted(uids[:2])]
+        assert metrics[f"{PREFIX}/inflight_reissued"] == 2 and metrics[f"{PREFIX}/inflight_ttl_suspended"] == 1
+        rb._sync_metadata_from_transfer_queue()
+        assert rb._recover_stuck_inflight(partition_id, metrics, reissue_budget=2) is False
+        assert reissuer.calls == [sorted(uids[:2])] and uids[2] in rb.running_keys[partition_id]
+    finally:
+        _clear_partition(partition_id)
+
+
+def test_step_budget_defaults_to_the_per_prompt_cap_plus_one_times_the_steps_prompt_count():
+    reissue_fn = lambda partition, uids: []  # noqa: E731
+    assert _make_rb(inflight_ttl_s=1, max_inflight_reissues=3, reissue_fn=reissue_fn)._reissue_budget(16) == 64
+    rb = _make_rb(inflight_ttl_s=1, max_inflight_reissues=3, reissue_fn=reissue_fn, train_batch_size=8)
+    assert rb._reissue_budget(16) == 32, "the step's prompt count, not the sampling call's batch size"
+    assert _make_rb(inflight_ttl_s=1, max_inflight_reissues=0, reissue_fn=reissue_fn)._reissue_budget(16) == 16
+    assert _make_rb(inflight_ttl_s=1, max_inflight_reissues_per_step=5, reissue_fn=reissue_fn)._reissue_budget(16) == 5
+    for bad in (True, -1, 1.5, 0):
+        with pytest.raises(AssertionError, match="max_inflight_reissues_per_step"):
+            _make_rb(inflight_ttl_s=1, max_inflight_reissues_per_step=bad, reissue_fn=reissue_fn)
+
+
+def test_zero_max_inflight_reissues_fails_an_expired_prompt_on_its_first_expiry(tq_init, partition_id):
+    """``max_inflight_reissues=0`` means never re-issue: the default budget is one failure per prompt of the
+    step and the expired prompt is failed under a fresh uid at once (another group of the step is finished, so
+    the padding-mode guard does not apply)."""
+    stuck, finished = _uid(), _uid()
+    _submit_prompt(partition_id, stuck, "running", 1, dispatched_at=time.time() - 100)
+    _submit_prompt(partition_id, finished, "running", 1, dispatched_at=time.time())
+    _finish(partition_id, finished, 1)
+    reissuer = RecordingReissuer(partition_id)
+    try:
+        rb = _make_rb(inflight_ttl_s=1, max_inflight_reissues=0, reissue_fn=reissuer)
+        rb._begin_ttl_budget(partition_id, 1)
+        rb._sync_metadata_from_transfer_queue()
+        metrics: dict = {}
+        budget = rb._reissue_budget(4)
+        assert rb._recover_stuck_inflight(partition_id, metrics, reissue_budget=budget, keep_last_finishable=True)
+        assert reissuer.calls == [] and stuck in rb._retired_uids[partition_id]
+        assert (
+            metrics[f"{PREFIX}/inflight_reissue_exhausted"] == 1 and f"{PREFIX}/inflight_ttl_suspended" not in metrics
+        )
+        assert rb._ttl_discards_in_step[partition_id] == 1, "the failure is charged against the step budget"
+        assert [k for k, t in _partition_items(partition_id).items() if t.get("status") == "failure"]
+    finally:
+        _clear_partition(partition_id)
+
+
+def test_exhaustion_failures_are_charged_against_the_budget_and_the_drain_still_discards(tq_init, partition_id):
+    """A re-issue and the failure that ends an exhausted prompt both spend the step budget: with budget 2 the
+    re-issue and one exhaustion go through, a second exhausted prompt is held back (suspension reported) and
+    stays in flight, while the sync DAPO drain still discards an expired in-flight group (never charged)."""
+    first, exhausted, held, drained = _uid(), _uid(), _uid(), _uid()
+    _submit_prompt(partition_id, first, "running", 1, dispatched_at=time.time() - 100)
+    reissuer = RecordingReissuer(partition_id)
+    try:
+        rb = _make_rb(inflight_ttl_s=1, max_inflight_reissues=1, max_inflight_reissues_per_step=2, reissue_fn=reissuer)
+        rb._begin_ttl_budget(partition_id, 1)
+        rb._sync_metadata_from_transfer_queue()
+        metrics: dict = {}
+        assert rb._recover_stuck_inflight(partition_id, metrics, reissue_budget=2) is True
+        assert reissuer.calls == [[first]] and rb._ttl_discards_in_step[partition_id] == 1
+        _submit_prompt(partition_id, exhausted, "running", 1, dispatched_at=time.time() - 100, attempt=2)
+        rb._sync_metadata_from_transfer_queue()
+        assert rb._recover_stuck_inflight(partition_id, metrics, reissue_budget=2) is True
+        assert exhausted in rb._retired_uids[partition_id] and rb._ttl_discards_in_step[partition_id] == 2
+        assert metrics[f"{PREFIX}/inflight_reissue_exhausted"] == 1
+        assert f"{PREFIX}/inflight_ttl_suspended" not in metrics, "nothing held back yet"
+        _submit_prompt(partition_id, held, "running", 1, dispatched_at=time.time() - 100, attempt=2)
+        rb._sync_metadata_from_transfer_queue()
+        assert rb._recover_stuck_inflight(partition_id, metrics, reissue_budget=2) is False
+        assert held in rb.running_keys[partition_id] and held not in rb._retired_uids[partition_id]
+        assert metrics[f"{PREFIX}/inflight_ttl_suspended"] == 1 and metrics[f"{PREFIX}/inflight_reissue_exhausted"] == 1
+        _submit_prompt(partition_id, drained, "running", 1, dispatched_at=time.time() - 100)
+        rb._sync_metadata_from_transfer_queue()
+        assert rb._recover_stuck_inflight(partition_id, metrics, draining=True, reissue_budget=2) is True
+        assert drained not in _partition_items(partition_id) and drained in rb._retired_uids[partition_id]
+        assert metrics[f"{PREFIX}/inflight_discarded_while_draining"] == 2, "held and drained, both discarded"
+        assert reissuer.calls == [[first]] and rb._ttl_discards_in_step[partition_id] == 2
+    finally:
+        _clear_partition(partition_id)
+
+
+def test_step_budget_is_shared_by_the_sampling_calls_of_one_step_and_reset_by_the_next(tq_init, partition_id):
+    """``parameter_sync_step > 1``: the sampling calls of one ``global_steps`` share the allowance; the next
+    step opens a fresh one (through the real ``sample`` entry point)."""
+    older, newer, later = _uid(), _uid(), _uid()
+    _submit_prompt(partition_id, older, "running", 1, dispatched_at=time.time() - 200)
+    _submit_prompt(partition_id, newer, "running", 1, dispatched_at=time.time() - 100)
+    reissuer = RecordingReissuer(partition_id)
+    try:
+        rb = _make_rb(inflight_ttl_s=1, max_inflight_reissues_per_step=1, reissue_fn=reissuer)
+        batch, metrics = SampleThread(
+            lambda: rb.sample(global_steps=1, partition_id=partition_id, batch_size=1)
+        ).result_or_raise()
+        assert reissuer.calls == [[older]] and metrics[f"{PREFIX}/inflight_ttl_suspended"] == 1
+        # Second call of the same step: the allowance is spent, `newer` waits until its worker finishes it.
+        thread = SampleThread(lambda: rb.sample(global_steps=1, partition_id=partition_id, batch_size=1))
+        thread.start()
+        time.sleep(0.3)
+        _finish(partition_id, newer, 1)
+        batch, _ = thread.result_or_raise()
+        assert [key.split("_")[0] for key in batch.keys] == [newer] and reissuer.calls == [[older]]
+        # Next step: a fresh allowance.
+        _submit_prompt(partition_id, later, "running", 2, dispatched_at=time.time() - 100)
+        SampleThread(lambda: rb.sample(global_steps=2, partition_id=partition_id, batch_size=1)).result_or_raise()
+        assert reissuer.calls == [[older], [later]]
+    finally:
+        _clear_partition(partition_id)
+
+
+def test_padding_mode_never_lets_the_ttl_fail_the_last_finishable_groups(tq_init, partition_id, caplog):
+    """Sync mode without ``sync_refill_failed_groups`` (the default): a failure is padded, never replaced, so
+    failing every expired prompt would end ``sample`` in the all-failed RuntimeError. The sampler holds the
+    last finishable groups back, suspends the TTL for the step (metric, one warning) and waits: healthy
+    generations slower than the TTL are trained on. Once another group is finished, an exhausted prompt is
+    failed as usual."""
+    caplog.set_level(logging.WARNING, logger=ReplayBuffer.__module__)
+    slow_a, slow_b = _uid(), _uid()
+    for uid in (slow_a, slow_b):
+        _submit_prompt(partition_id, uid, "running", 1, dispatched_at=time.time() - 100)
+    reissuer = RecordingReissuer(partition_id)
+    try:
+        rb = _make_rb(inflight_ttl_s=1, max_inflight_reissues=0, reissue_fn=reissuer)
+        thread = SampleThread(lambda: rb.sample(global_steps=1, partition_id=partition_id, batch_size=2))
+        thread.start()
+        deadline = time.time() + 10
+        while not any("holding them back" in record.message for record in caplog.records):
+            assert thread.is_alive() and time.time() < deadline, "the last groups were not held back"
+            time.sleep(POLL_INTERVAL)
+        time.sleep(0.3)
+        assert set(_inflight_prompt_uids(partition_id)) == {slow_a, slow_b}, "nothing failed, nothing re-issued"
+        _finish(partition_id, slow_a, 1)
+        _finish(partition_id, slow_b, 1)
+        batch, metrics = thread.result_or_raise()
+        assert {key.split("_")[0] for key in batch.keys} == {slow_a, slow_b}
+        assert metrics[f"{PREFIX}/inflight_ttl_suspended"] == 1 and reissuer.calls == []
+        assert metrics.get(f"{PREFIX}/inflight_reissue_exhausted", 0) == 0
+        assert sum("holding them back" in record.message for record in caplog.records) == 1
+        # Step 2: a finished group exists, so an exhausted prompt is failed (and charged) as usual.
+        exhausted, done = _uid(), _uid()
+        _submit_prompt(partition_id, exhausted, "running", 2, dispatched_at=time.time() - 100)
+        _submit_prompt(partition_id, done, "running", 2, dispatched_at=time.time())
+        _finish(partition_id, done, 2)
+        batch, metrics = SampleThread(
+            lambda: rb.sample(global_steps=2, partition_id=partition_id, batch_size=2)
+        ).result_or_raise()
+        assert metrics[f"{PREFIX}/inflight_reissue_exhausted"] == 1 and exhausted in rb._retired_uids[partition_id]
+        assert {key.split("_")[0] for key in batch.keys} == {done}, "the failure group is padded, not materialized"
+    finally:
+        _clear_partition(partition_id)
+
+
+def test_hold_back_is_lifted_once_another_group_finished_so_a_dead_writer_is_padded(tq_init, partition_id, caplog):
+    """Padding mode, TTL below the healthy generation time: a prompt whose writer is dead beside a healthy slow
+    one. Both expire together and are held back (nothing else finishable). The hold-back charges nothing and is
+    re-evaluated every poll: once the healthy group has finished, the dead one is failed under the normal budget
+    and the step completes padded, instead of hanging on it."""
+    caplog.set_level(logging.WARNING, logger=ReplayBuffer.__module__)
+    dead, healthy = _uid(), _uid()
+    for uid in (dead, healthy):
+        _submit_prompt(partition_id, uid, "running", 1, dispatched_at=time.time() - 100)
+    reissuer = RecordingReissuer(partition_id)
+    try:
+        rb = _make_rb(inflight_ttl_s=1, max_inflight_reissues=0, reissue_fn=reissuer)
+        thread = SampleThread(lambda: rb.sample(global_steps=1, partition_id=partition_id, batch_size=2))
+        thread.start()
+        deadline = time.time() + 10
+        while not any("holding them back" in record.message for record in caplog.records):
+            assert thread.is_alive() and time.time() < deadline, "the last groups were not held back"
+            time.sleep(POLL_INTERVAL)
+        assert rb._ttl_discards_in_step[partition_id] == 0, "a hold-back charges nothing"
+        _finish(partition_id, healthy, 1)  # the healthy generation finishes; the dead writer never does
+        batch, metrics = thread.result_or_raise()
+        assert [key.split("_")[0] for key in batch.keys] == [healthy], "trained on the healthy row, dead one padded"
+        assert metrics[f"{PREFIX}/inflight_reissue_exhausted"] == 1 and dead in rb._retired_uids[partition_id]
+        assert metrics[f"{PREFIX}/inflight_ttl_suspended"] == 1 and reissuer.calls == []
+        assert rb._ttl_discards_in_step[partition_id] == 1, "the failure is charged normally"
+    finally:
+        _clear_partition(partition_id)
+
+
+def test_dead_worker_prompts_are_reissued_even_when_the_ttl_budget_is_spent(tq_init, partition_id):
+    """The step budget bounds the TTL only: with the budget already spent an expired prompt waits (TTL
+    suspended), while a prompt whose worker the liveness probe reports dead is still re-issued, and that
+    re-issue does not count against the budget."""
+    expired, dead = _uid(), _uid()
+    _submit_prompt(partition_id, expired, "running", 1, dispatched_at=time.time() - 100)
+    _submit_prompt(partition_id, dead, "running", 1, dispatched_at=time.time())
+    reissuer = RecordingReissuer(partition_id)
+    try:
+        rb = _make_rb(
+            inflight_ttl_s=1,
+            max_inflight_reissues_per_step=1,
+            reissue_fn=reissuer,
+            liveness_fn=lambda inflight: {dead} & inflight,
+            liveness_period_s=0.0,
+        )
+        rb._begin_ttl_budget(partition_id, 1)
+        rb._ttl_discards_in_step[partition_id] = 1  # the step's budget is already spent
+        rb._sync_metadata_from_transfer_queue()
+        metrics: dict = {}
+        assert rb._recover_stuck_inflight(partition_id, metrics, reissue_budget=1) is True
+        assert reissuer.calls == [[dead]]
+        assert metrics[f"{PREFIX}/inflight_reissued"] == 1
+        assert metrics[f"{PREFIX}/inflight_dead_worker_reissued"] == 1
+        assert metrics[f"{PREFIX}/inflight_ttl_suspended"] == 1
+        rb._sync_metadata_from_transfer_queue()
+        assert rb._recover_stuck_inflight(partition_id, metrics, reissue_budget=1) is False
+        assert reissuer.calls == [[dead]] and expired in rb.running_keys[partition_id]
+    finally:
+        _clear_partition(partition_id)
+
+
+def test_dead_worker_death_events_are_bounded_per_step_and_fail_loudly(tq_init, partition_id):
+    """A liveness probe that keeps reporting every replacement's worker dead (a worker that dies after every
+    served dispatch, or a parked chunk whose worker never answers) must not re-issue and refill forever: the
+    probes of a step that report dead workers (death events) are bounded by the same allowance as the TTL's
+    discards, and beyond it the buffer raises instead of looping or hanging. One death that orphans many prompts
+    is a single event, so a large recoverable death never trips the bound."""
+    first, second, third = _uid(), _uid(), _uid()
+    for uid in (first, second):
+        _submit_prompt(partition_id, uid, "running", 1, dispatched_at=time.time())
+    reissuer = RecordingReissuer(partition_id)
+    try:
+        rb = _make_rb(
+            inflight_ttl_s=1,
+            max_inflight_reissues=0,
+            max_inflight_reissues_per_step=1,
+            reissue_fn=reissuer,
+            liveness_fn=lambda inflight: set(inflight),
+            liveness_period_s=0.0,
+        )
+        rb._begin_ttl_budget(partition_id, 1)
+        rb._sync_metadata_from_transfer_queue()
+        metrics: dict = {}
+        assert rb._recover_stuck_inflight(partition_id, metrics, reissue_budget=1) is True
+        assert metrics[f"{PREFIX}/inflight_reissue_exhausted"] == 2, "one death orphaning two prompts: one event"
+        assert rb._dead_worker_events_in_step[partition_id] == 1 and rb._dead_worker_discards_in_step[partition_id] == 2
+        assert rb._ttl_discards_in_step[partition_id] == 0, "dead-worker failures are not TTL discards"
+        _submit_prompt(partition_id, third, "running", 1, dispatched_at=time.time())  # the refill, dead again
+        rb._sync_metadata_from_transfer_queue()
+        with pytest.raises(RuntimeError, match="agent-loop workers keep dying: 2 liveness probes of step 1"):
+            rb._recover_stuck_inflight(partition_id, metrics, reissue_budget=1)
+        assert reissuer.calls == [] and rb._dead_worker_discards_in_step[partition_id] == 3
+    finally:
+        _clear_partition(partition_id)
